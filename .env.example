# ============================================================
# LLM Dashboard — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database
DATABASE_URL=postgresql+asyncpg://llmuser:llmpassword@localhost:5432/llmdashboard

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Default governance limits
DEFAULT_DAILY_TOKEN_LIMIT=1000000
DEFAULT_MONTHLY_TOKEN_LIMIT=20000000
DEFAULT_MONTHLY_BUDGET_USD=100.0

# LLM Providers — set real keys for providers you want to use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# M4/M5 LLM Configuration
M4_DEFAULT_PROVIDER=groq
M4_DEFAULT_MODEL=llama-3.3-70b-versatile

# Company Branding (used in PDF invoices, emails)
COMPANY_NAME=Your Company Name
COMPANY_TAGLINE=Your Tagline
COMPANY_ADDRESS=Your Address
COMPANY_EMAIL=billing@your-domain.com
COMPANY_WEB=https://your-domain.com

# API Version
API_VERSION=2026-04-01
