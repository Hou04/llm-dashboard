@startuml ch6_seq_prompt_mgmt
' ============================================================
' CHAPITRE 6 — Diagramme de Séquence — Gestion des Prompts
' Figure 6.x : Cycle de vie d'un template de prompt
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 5
skinparam sequenceArrowThickness 2

skinparam sequence {
  ParticipantBackgroundColor #2C3E50
  ParticipantFontColor #FFFFFF
  ParticipantBorderColor #1A252F
  LifeLineBackgroundColor #E8E8E8
  ArrowColor #2C3E50
}

title <size:16><b>Diagramme de Séquence — Gestion des Templates de Prompts</b></size>

actor "Administrateur\nTenant" as Admin
participant "Frontend\nNext.js" as UI
participant "API REST\nFastAPI" as API
participant "PromptService" as PS
database "PostgreSQL\nprompt_template" as DB
participant "Jinja2\nEngine" as J2

== Création d'un template ==

Admin -> UI : Accéder au CMS de prompts
Admin -> UI : Remplir le formulaire\n(nom, contenu, variables, catégorie)
activate UI

UI -> API : POST /v1/prompts/templates\n{ name, content, variables, category }
activate API

API -> PS : create_template(data)
activate PS
PS -> PS : Valider le contenu Jinja2\n(syntaxe, variables déclarées)
PS -> DB : INSERT INTO prompt_template\n(status='DRAFT', version=1)
activate DB
DB --> PS : template_id
deactivate DB
PS --> API : PromptTemplate (DRAFT, v1)
deactivate PS

API --> UI : 201 Created
deactivate API

UI --> Admin : Template créé (Brouillon v1)
deactivate UI

== Publication ==

Admin -> UI : Cliquer "Publier"
activate UI

UI -> API : PATCH /v1/prompts/templates/{id}/publish
activate API

API -> PS : publish(template_id)
activate PS
PS -> DB : UPDATE prompt_template\nSET status='PUBLISHED'
activate DB
DB --> PS : OK
deactivate DB
PS --> API : PromptTemplate (PUBLISHED)
deactivate PS

API --> UI : 200 OK
deactivate API

UI --> Admin : Template publié ✓
deactivate UI

== Nouvelle version ==

Admin -> UI : Modifier le contenu
activate UI

UI -> API : POST /v1/prompts/templates/{id}/versions\n{ new_content }
activate API

API -> PS : increment_version(template_id)
activate PS
PS -> DB : INSERT INTO prompt_template\n(parent_id, version=2, status='DRAFT')
activate DB
DB --> PS : new_template_id
deactivate DB
note right of PS
  L'ancienne version reste
  PUBLISHED jusqu'à
  publication de v2
end note
PS --> API : PromptTemplate (DRAFT, v2)
deactivate PS

API --> UI : 201 Created
deactivate API
deactivate UI

== Rendu dynamique ==

Admin -> UI : Tester avec variables\n{ "client": "QALITAS", "model": "GPT-4o" }
activate UI

UI -> API : POST /v1/prompts/templates/{id}/render\n{ variables }
activate API

API -> PS : render(template_id, variables)
activate PS

PS -> DB : SELECT template_content\nFROM prompt_template
activate DB
DB --> PS : "Analysez les KPIs de {{client}}\nen utilisant {{model}}"
deactivate DB

PS -> J2 : render(template, variables)
activate J2
J2 --> PS : "Analysez les KPIs de QALITAS\nen utilisant GPT-4o"
deactivate J2

PS --> API : rendered_prompt
deactivate PS

API --> UI : { rendered: "Analysez les KPIs..." }
deactivate API

UI --> Admin : Aperçu du prompt rendu
deactivate UI

@enduml
