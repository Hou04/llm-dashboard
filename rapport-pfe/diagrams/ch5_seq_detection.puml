@startuml ch5_seq_detection
' ============================================================
' CHAPITRE 5 — Diagramme de Séquence — Pipeline de Détection
' Figure 5.x : Pipeline de détection d'anomalies
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 5
skinparam sequenceArrowThickness 2

skinparam participant {
  BackgroundColor #9B59B6
  FontColor #FFFFFF
  BorderColor #7D3C98
}

title <size:16><b>Diagramme de Séquence — Pipeline de Détection d'Anomalies</b></size>

participant "Event Bus" as EB #8E44AD
participant "Detection\nService" as DS #9B59B6
participant "STL\nDecomposer" as STL #E74C3C
participant "Isolation\nForest" as IF #3498DB
participant "CUSUM\nDetector" as CU #E67E22
database "PostgreSQL\n(llm_anomaly)" as DB #27AE60
database "PostgreSQL\n(llm_token_baseline)" as BL #27AE60
participant "Event Bus\n(output)" as EBO #8E44AD

EB -> DS : event: "llm.call.completed"\n{tenant_id, model, tokens, cost}
activate DS

== 1. Récupération des données historiques ==

DS -> DB : get_token_logs(tenant_id,\nlookback_days=14)
activate DB
DB --> DS : List<TokenLog> (N entrées)
deactivate DB

DS -> BL : get_baseline(tenant_id,\nmodel, dimension)
activate BL
BL --> DS : LLMTokenBaseline\n{mean, std, median}
deactivate BL

== 2. Exécution des 3 algorithmes ML ==

DS -> STL : run_stl(time_series, period=24)
activate STL
STL -> STL : Décomposition :\nY(t) = T(t) + S(t) + R(t)
STL -> STL : Calcul z-score :\nz = (R(t) - μR) / σR
STL --> DS : STL_Result\n{residuals, z_scores,\nanomalies: [t1, t5]}
deactivate STL

DS -> IF : run_isolation_forest(\nfeatures_matrix,\ncontamination=0.05)
activate IF
IF -> IF : Construction de\n100 arbres d'isolation
IF -> IF : Score : s(x,n) =\n2^(-E[h(x)]/c(n))
IF --> DS : IF_Result\n{scores, anomaly_indices: [t3]}
deactivate IF

DS -> CU : run_cusum(time_series,\nbaseline_mean, k=0.5, h=4)
activate CU
CU -> CU : S(t) = max(0,\nS(t-1) + x(t) - μ₀ - k)
CU -> CU : Alarme si S(t) > h
CU --> DS : CUSUM_Result\n{cumsum_values,\nalarm_indices: [t5, t6]}
deactivate CU

== 3. Fusion et classification ==

DS -> DS : merge_and_deduplicate()\nFusion des anomalies\ndes 3 algorithmes

DS -> DS : classify_severity()\n• |z| > 4 → CRITICAL\n• |z| > 3 → WARNING\n• |z| > 2 → INFO

== 4. Persistance ==

loop Pour chaque anomalie détectée
  DS -> DB : INSERT INTO llm_anomaly\n(tenant_id, type, severity,\nalgorithm, z_score,\nexpected, actual, details)
  activate DB
  DB --> DS : anomaly_id
  deactivate DB
end

== 5. Publication des événements ==

loop Pour chaque anomalie
  DS -> EBO : publish("anomaly.detected",\n{anomaly_id, tenant_id,\nseverity, type})
  activate EBO
  EBO --> DS : OK
  deactivate EBO
end

== 6. Mise à jour des baselines ==

DS -> BL : update_baseline(\ntenant_id, new_stats)
activate BL
BL --> DS : OK
deactivate BL

deactivate DS

@enduml
