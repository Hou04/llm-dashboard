@startuml ch3_class_global

' ============================================================
' Diagramme de Classes Métier — Vue Globale
' Style professionnel académique UML
' ============================================================

left to right direction

skinparam backgroundColor #F7F7F2
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 6
skinparam linetype ortho
skinparam shadowing false

skinparam class {
    BackgroundColor white
    BorderColor #444444
    FontColor black
    HeaderBackgroundColor #EAEAEA
    HeaderFontColor black
}

skinparam ArrowColor #444444
skinparam packageBorderColor #666666
skinparam packageBackgroundColor transparent

title <size:16><b>Diagramme de Classes Métier — Vue Globale</b></size>

' ============================================================
' ENUMERATION
' ============================================================

enum Role {
  ADMIN
  ANALYST
  USER
}

' ============================================================
' AUTHENTIFICATION
' ============================================================

package "Authentification & Gestion Tenant" {

class LLMTenant <<Model>> {
  +id : UUID
  +name : String
  +slug : String
  +is_active : Boolean

  +activate()
  +deactivate()
}

class LLMAuthUser <<Model>> {
  +id : UUID
  +email : String
  +full_name : String
  +role : Role
  +is_active : Boolean

  +authenticate()
  +updateProfile()
}

class LLMApiKey <<Model>> {
  +id : UUID
  +name : String
  +key_hash : String
  +is_active : Boolean

  +generateKey()
  +revokeKey()
}

}

' ============================================================
' GATEWAY & ANALYTICS
' ============================================================

package "Gateway & Analytics" {

class LLMTokenLog <<Model>> {
  +id : UUID
  +provider : String
  +model : String
  +input_tokens : Integer
  +output_tokens : Integer
  +cost_usd : Decimal

  +calculateCost()
}

class GovernanceRule <<Model>> {
  +id : UUID
  +rule_type : String
  +threshold : Float
  +scope : String

  +validateUsage()
}

class LLMCostDaily <<Model>> {
  +date : Date
  +total_tokens : BigInt
  +total_cost : Decimal

  +aggregateDailyCost()
}

class LLMCostMonthly <<Model>> {
  +month : Integer
  +year : Integer
  +total_cost : Decimal

  +generateMonthlyReport()
}

class AnalyticsDashboard <<View>> {
  +displayMetrics()
  +displayUsageCharts()
}

}

' ============================================================
' DETECTION & AI
' ============================================================

package "Détection d'Anomalies" {

class LLMAnomaly <<Model>> {
  +id : UUID
  +anomaly_type : String
  +severity : String
  +z_score : Float

  +detectAnomaly()
}

class AnomalyExplanation <<Model>> {
  +root_cause : String
  +recommendations : JSON

  +generateExplanation()
}

class LLMTokenBaseline <<Model>> {
  +dimension : String
  +mean_value : Float
  +std_value : Float

  +calculateBaseline()
}

class ForecastResult <<Model>> {
  +optimistic_cost : Decimal
  +baseline_cost : Decimal
  +pessimistic_cost : Decimal
  +risk_level : String

  +predictFutureCost()
}

class DetectionService <<Controller>> {
  +analyzeUsage()
  +generateForecast()
}

}

' ============================================================
' BILLING
' ============================================================

package "Billing & Facturation" {

class BillingContract <<Model>> {
  +contract_type : String
  +status : String
  +base_fee : Decimal

  +calculateOverage()
}

class Invoice <<Model>> {
  +total_amount : Decimal
  +status : String

  +generateInvoice()
}

class InvoiceLineItem <<Model>> {
  +model : String
  +tokens : BigInt
  +total_price : Decimal
}

class BillingDashboard <<View>> {
  +displayInvoices()
  +displayBillingStats()
}

}

' ============================================================
' SESSIONS & PROMPTS
' ============================================================

package "Sessions & Prompt Engineering" {

class LLMSession <<Model>> {
  +total_turns : Integer
  +total_tokens : BigInt
  +total_cost : Decimal

  +closeSession()
}

class PromptTemplate <<Model>> {
  +name : String
  +version : Integer
  +status : String

  +publishTemplate()
}

}

' ============================================================
' RELATIONS
' ============================================================

LLMTenant "1" --o "0..*" LLMAuthUser
LLMTenant "1" --o "0..*" LLMApiKey
LLMTenant "1" --o "0..*" LLMTokenLog
LLMTenant "1" --o "0..*" GovernanceRule
LLMTenant "1" --o "0..*" LLMCostDaily
LLMTenant "1" --o "0..*" LLMAnomaly
LLMTenant "1" --o "0..1" BillingContract
LLMTenant "1" --o "0..*" LLMSession
LLMTenant "1" --o "0..*" PromptTemplate

LLMAuthUser --> Role

LLMAuthUser "1" --o "0..*" LLMApiKey

LLMTokenLog "0..*" --> "1" LLMCostDaily
LLMCostDaily "0..*" --> "1" LLMCostMonthly

LLMAnomaly "1" --> "0..1" AnomalyExplanation
LLMAnomaly "0..*" --> "1" LLMTokenBaseline

BillingContract "1" --> "0..*" Invoice
Invoice "1" --o "1..*" InvoiceLineItem

LLMSession "0..*" --> "1" LLMTokenLog

ForecastResult ..> LLMCostDaily

AnalyticsDashboard ..> LLMCostDaily
BillingDashboard ..> Invoice
DetectionService ..> LLMAnomaly
DetectionService ..> ForecastResult

@enduml