@startuml ch5_class_analytics
' ============================================================
' CHAPITRE 5 — Diagramme de Classes — Module Analytics
' Figure 5.x : Classes du module Analytics, Forecasting et Optimizer
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 5
skinparam linetype ortho

skinparam class {
  BackgroundColor #ECF0F1
  BorderColor #2C3E50
  FontColor #2C3E50
  HeaderBackgroundColor #2C3E50
  HeaderFontColor #FFFFFF
}

title <size:16><b>Diagramme de Classes — Modules Analytics, Forecasting et Optimizer</b></size>

class LLMCostDaily {
  id : UUID
  tenant_id : UUID
  date : Date
  provider : String
  model : String
  total_input_tokens : BigInt
  total_output_tokens : BigInt
  total_tokens : BigInt
  total_cost : Decimal(12,6)
  request_count : Integer
  error_count : Integer
  avg_latency_ms : Float
  created_at : DateTime
}

class LLMCostMonthly {
  id : UUID
  tenant_id : UUID
  month : Integer
  year : Integer
  provider : String
  model : String
  total_tokens : BigInt
  total_cost : Decimal(12,6)
  request_count : Integer
}

class LLMModelPricing {
  id : UUID
  provider : String
  model : String
  input_price_per_1k : Decimal(10,8)
  output_price_per_1k : Decimal(10,8)
  effective_from : Date
  effective_to : Date?
  is_active : Boolean
}

class AnalyticsService {
  - cost_daily_repo : CostDailyRepository
  - cost_monthly_repo : CostMonthlyRepository
  - pricing_repo : PricingRepository
  --
  + aggregate_daily(tenant_id, date) : LLMCostDaily
  + rollup_monthly(tenant_id, month, year) : LLMCostMonthly
  + get_cost_breakdown(tenant_id, period) : CostBreakdown
  + get_top_models(tenant_id, limit) : List<ModelUsage>
}

class ForecastResult {
  id : UUID
  tenant_id : UUID
  horizon_days : Integer
  optimistic_cost : Decimal
  baseline_cost : Decimal
  pessimistic_cost : Decimal
  daily_trend : Float
  growth_rate : Float
  seasonality_factor : Float
  risk_level : String
  created_at : DateTime
}

class ForecastService {
  - cost_daily_repo : CostDailyRepository
  - forecast_repo : ForecastRepository
  --
  + forecast(tenant_id, horizon_days) : ForecastResult
  - _compute_trend(data) : Float
  - _compute_growth_rate(data) : Float
  - _project(trend, rate, days) : Decimal
  - _assess_budget_risks(cost, tenant_id) : List<Risk>
}

class OptimizationRecommendation {
  id : UUID
  tenant_id : UUID
  recommendation_type : String
  current_model : String
  suggested_model : String?
  estimated_savings : Decimal
  confidence : Float
  status : String
  created_at : DateTime
}

enum RecommendationStatus <<enumeration>> {
  PROPOSED
  VALIDATED
  DEPLOYED
  REJECTED
}

class OptimizerService {
  - analytics_svc : AnalyticsService
  - pricing_repo : PricingRepository
  --
  + run_weekly_scan(tenant_id) : List<Recommendation>
  - _find_cheaper_models(usage) : List<ModelSwap>
  - _calculate_roi(swap) : Decimal
}

' ═══════ RELATIONS ═══════

AnalyticsService --> LLMCostDaily : produit >
AnalyticsService --> LLMCostMonthly : agrège dans >
AnalyticsService --> LLMModelPricing : utilise >

LLMCostDaily "0..*" --> "1" LLMCostMonthly : rollup >

ForecastService --> LLMCostDaily : analyse >
ForecastService --> ForecastResult : génère >

OptimizerService --> AnalyticsService : consomme >
OptimizerService --> OptimizationRecommendation : produit >
OptimizationRecommendation --> RecommendationStatus

@enduml
