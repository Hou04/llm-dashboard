@startuml ch4_class_gateway
' ============================================================
' CHAPITRE 4 — Diagramme de Classes — Module Gateway
' Figure 4.x : Classes du module Gateway et Gouvernance
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 5
skinparam linetype ortho

skinparam class {
  BackgroundColor #ECF0F1
  BorderColor #2C3E50
  FontColor #2C3E50
  HeaderBackgroundColor #2C3E50
  HeaderFontColor #FFFFFF
}

title <size:16><b>Diagramme de Classes — Module Gateway</b></size>

enum RuleType <<enumeration>> {
  RATE_LIMIT
  BUDGET_CAP
  MODEL_RESTRICTION
  TOKEN_LIMIT
  TIME_RESTRICTION
}

enum RuleAction <<enumeration>> {
  BLOCK
  ALERT
  LOG
}

class GatewayService {
  - governance_engine : GovernanceEngine
  - semantic_cache : SemanticCacheService
  - provider_registry : ProviderRegistry
  - log_repository : TokenLogRepository
  --
  + process_llm_call(request, tenant_id) : LLMCallResponse
  - _route_to_provider(request) : LLMCallResponse
  - _publish_event(event_name, data) : void
}

class GovernanceEngine {
  - rule_repository : GovernanceRuleRepository
  - redis_client : Redis
  --
  + evaluate(request, tenant_id) : GovernanceDecision
  - _check_rate_limit(tenant_id) : bool
  - _check_budget_cap(tenant_id) : bool
  - _check_model_restriction(request) : bool
  - _check_token_limit(request) : bool
  - _check_time_restriction() : bool
}

class GovernanceRule {
  id : UUID
  tenant_id : UUID
  rule_type : RuleType
  action : RuleAction
  threshold : Float
  scope : String
  is_active : Boolean
  created_at : DateTime
  updated_at : DateTime
}

class GovernanceDecision {
  action : String
  reason : String
  rule_id : UUID?
  matched_rules : List<GovernanceRule>
}

class SemanticCacheService {
  - redis_client : Redis
  - embedder : SentenceTransformer
  - similarity_threshold : Float = 0.95
  --
  + get(prompt, tenant_id) : CachedResponse?
  + set(prompt, response, tenant_id) : void
  + invalidate(tenant_id) : void
}

class LLMTokenLog {
  id : UUID
  tenant_id : UUID
  user_id : UUID?
  api_key_id : UUID
  timestamp : DateTime
  provider : String
  model : String
  input_tokens : Integer
  output_tokens : Integer
  total_tokens : Integer
  cost_usd : Decimal
  latency_ms : Integer
  status : String
  session_id : UUID?
  metadata : JSONB
}

class ProviderRegistry {
  - providers : Map<String, LLMProvider>
  --
  + get_provider(name) : LLMProvider
  + list_available() : List<String>
}

interface LLMProvider <<interface>> {
  + call(request) : LLMCallResponse
  + health_check() : bool
}

class OpenAIProvider
class AnthropicProvider
class GoogleProvider
class GroqProvider
class CohereProvider

' ═══════ RELATIONS ═══════

GatewayService --> GovernanceEngine : utilise >
GatewayService --> SemanticCacheService : interroge >
GatewayService --> ProviderRegistry : route via >
GatewayService --> LLMTokenLog : journalise >

GovernanceEngine --> GovernanceRule : évalue >
GovernanceEngine --> GovernanceDecision : produit >

ProviderRegistry "1" --o "1..*" LLMProvider
LLMProvider <|.. OpenAIProvider
LLMProvider <|.. AnthropicProvider
LLMProvider <|.. GoogleProvider
LLMProvider <|.. GroqProvider
LLMProvider <|.. CohereProvider

GovernanceRule --> RuleType
GovernanceRule --> RuleAction

@enduml
