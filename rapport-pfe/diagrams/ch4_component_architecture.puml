@startuml ch4_component_architecture
' ============================================================
' CHAPITRE 4 — Diagramme de Composants — Architecture
' Figure 4.x : Architecture modulaire du backend
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam linetype ortho

skinparam component {
  BackgroundColor #ECF0F1
  BorderColor #2C3E50
  FontColor #2C3E50
}

skinparam package {
  BackgroundColor #F8F9FA
  BorderColor #BDC3C7
  FontColor #2C3E50
}

skinparam interface {
  BackgroundColor #3498DB
}

title <size:16><b>Diagramme de Composants — Architecture Modulaire</b></size>

package "Couche Présentation" #E8F8F5 {
  component [Next.js 16\nReact 19\nTypeScript] as FE #1ABC9C;text:white
}

package "Couche API (FastAPI)" #EBF5FB {

  component [Auth\nModule] as AUTH #E74C3C;text:white
  component [Gateway\nModule] as GW #3498DB;text:white
  component [Dashboard\nModule] as DASH #2ECC71;text:white
  component [Analytics\nModule] as ANA #F39C12;text:white
  component [Detection\nModule] as DET #9B59B6;text:white
  component [Explainer\nModule] as EXP #8E44AD;text:white
  component [Forecasting\nModule] as FORE #E67E22;text:white
  component [Optimizer\nModule] as OPT #D35400;text:white
  component [Billing\nModule] as BILL #C0392B;text:white
  component [Tracing\nModule] as TRACE #16A085;text:white
  component [Prompts\nModule] as PRPT #2980B9;text:white

  component [Core\n(Event Bus, Security,\nObservability)] as CORE #2C3E50;text:white
}

package "Couche Traitement Asynchrone" #FDF2E9 {
  component [Celery Worker\n(Tâches async)] as CELW #9B59B6;text:white
  component [Celery Beat\n(Scheduler)] as CELB #8E44AD;text:white
}

package "Couche Données" #FDEDEC {
  database "PostgreSQL 15\n+ TimescaleDB\n+ pgvector" as PG #27AE60;text:white
  database "Redis 7\n(Cache + Broker\n+ Compteurs)" as RED #E74C3C;text:white
}

cloud "Fournisseurs LLM" as LLMP {
  component [OpenAI] as OAI
  component [Anthropic] as ANT
  component [Google] as GOO
  component [Groq] as GRQ
  component [Cohere] as COH
}

' ── Connexions Frontend ──
FE --> AUTH : REST API
FE --> DASH : REST + WebSocket
FE --> GW : REST API
FE --> ANA : REST API
FE --> DET : REST API
FE --> BILL : REST API

' ── Connexions modules vers Core ──
AUTH --> CORE
GW --> CORE
DET --> CORE
BILL --> CORE

' ── Gateway vers fournisseurs ──
GW --> LLMP : HTTP/HTTPS

' ── Modules vers données ──
CORE --> PG
CORE --> RED

' ── Event Bus ──
GW ..> DET : <<event>>\nllm.call.completed
DET ..> EXP : <<event>>\nanomaly.detected
EXP ..> DASH : <<event>>\nexplanation.ready

' ── Celery ──
CELB --> CELW : schedule
CELW --> ANA : aggregate_daily
CELW --> DET : run_detection
CELW --> FORE : generate_forecast
CELW --> OPT : run_scan
CELW --> PG
CELW --> RED

@enduml
