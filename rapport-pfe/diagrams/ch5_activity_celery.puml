@startuml ch5_activity_celery
' ============================================================
' CHAPITRE 5 — Diagramme d'Activité — Pipeline Celery
' Figure 5.x : Pipeline d'agrégation Celery
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 10

skinparam activity {
  BackgroundColor #ECF0F1
  BorderColor #2C3E50
  FontColor #2C3E50
}

skinparam swimlane {
  BorderColor #2C3E50
}

title <size:16><b>Diagramme d'Activité — Pipeline Celery Beat</b></size>

|Celery Beat\n(Scheduler)|
start
:Vérifier le calendrier\ndes tâches planifiées;

|#E8F8F5|Tâches Quotidiennes\n(Chaque nuit à 02h00)|
:aggregate_daily_costs();
note right
  Requête TimescaleDB :
  SELECT tenant_id, provider, model,
    SUM(total_tokens),
    SUM(cost_usd),
    COUNT(*), AVG(latency_ms)
  FROM llm_token_log
  WHERE timestamp >= yesterday
  GROUP BY tenant_id, provider, model
end note

:INSERT INTO llm_cost_daily;

:run_anomaly_detection();
note right
  Exécuter pour chaque tenant :
  • STL decomposition
  • Isolation Forest
  • CUSUM
end note

if (Anomalies détectées ?) then (oui)
  :Publier événements\n"anomaly.detected";
  :Déclencher Explainer\n(explication IA);
else (non)
  :Aucune action;
endif

|#FDF2E9|Tâches Mensuelles\n(1er du mois à 03h00)|
:rollup_monthly_costs();
note right
  Agréger les llm_cost_daily
  du mois précédent dans
  llm_cost_monthly
end note

:INSERT INTO llm_cost_monthly;

:generate_monthly_forecasts();
note right
  Pour chaque tenant :
  • Calculer tendance
  • 3 scénarios (optimiste,
    moyen, pessimiste)
  • Évaluer risques
end note

:INSERT INTO forecast_results;

|#FDEDEC|Tâches Hebdomadaires\n(Chaque lundi à 04h00)|
:run_optimization_scan();
note right
  Analyser les patterns d'usage :
  • Modèles sous-utilisés
  • Prompts inefficients
  • Substitutions possibles
end note

if (Recommandations ?) then (oui)
  :Créer des recommandations\nd'optimisation;
  :INSERT INTO\noptimization_recommendations;
else (non)
  :Aucune optimisation\nnécessaire;
endif

|Celery Beat\n(Scheduler)|
:Attendre le prochain\ncycle planifié;

stop

@enduml
