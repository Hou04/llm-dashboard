@startuml ch5_seq_explainer
' ============================================================
' CHAPITRE 5 — Diagramme de Séquence — Explication IA
' Figure 5.x : Explication IA d'une anomalie
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 5
skinparam sequenceArrowThickness 2

skinparam participant {
  BackgroundColor #8E44AD
  FontColor #FFFFFF
  BorderColor #6C3483
}

title <size:16><b>Diagramme de Séquence — Explication IA d'une Anomalie</b></size>

participant "Event Bus" as EB #8E44AD
participant "Explainer\nService" as ES #9B59B6
participant "Prompt\nBuilder" as PB #3498DB
participant "LLM Provider\n(Groq → OpenAI\n→ Anthropic)" as LLM #1ABC9C
participant "Embedding\nService" as EMB #E67E22
database "PostgreSQL\n(anomaly_explanation)" as DB #27AE60
database "PostgreSQL\n(pgvector)" as VEC #2ECC71
database "Redis\n(Cache)" as RED #E74C3C

EB -> ES : event: "anomaly.detected"\n{anomaly_id, tenant_id,\nseverity, type, details}
activate ES

== 1. Vérification du cache ==

ES -> RED : get_cached_explanation(\nanomaly_fingerprint)
activate RED

alt Cache HIT
  RED --> ES : CachedExplanation
  ES --> EB : (skip — déjà expliquée)
else Cache MISS
  RED --> ES : null
  deactivate RED
end

== 2. Construction du prompt contextuel ==

ES -> PB : build_prompt(anomaly)
activate PB

PB -> PB : Assembler le contexte :\n• Type d'anomalie\n• Valeur attendue vs réelle\n• Déviation (%)\n• Algorithme détecteur\n• Historique récent\n• Métadonnées tenant

PB --> ES : structured_prompt\n(system + user message)
deactivate PB

== 3. Appel LLM avec fallback ==

ES -> LLM : generate(prompt)\n[Provider 1: Groq]
activate LLM

alt Groq disponible
  LLM --> ES : LLM_Response\n{explanation, recommendations}
else Groq indisponible
  LLM --> ES : ProviderError
  ES -> LLM : generate(prompt)\n[Provider 2: OpenAI]
  alt OpenAI disponible
    LLM --> ES : LLM_Response
  else OpenAI indisponible
    ES -> LLM : generate(prompt)\n[Provider 3: Anthropic]
    LLM --> ES : LLM_Response
  end
end
deactivate LLM

== 4. Parsing de la réponse structurée ==

ES -> ES : parse_explanation()\n• root_cause : String\n• impact : String\n• recommendations : List[String]\n• confidence : Float

== 5. Génération des embeddings ==

ES -> EMB : encode(explanation_summary)
activate EMB
EMB -> EMB : Sentence embedding\n384 dimensions
EMB --> ES : Vector[384]
deactivate EMB

== 6. Persistance ==

ES -> DB : INSERT INTO\nanomaly_explanation\n(anomaly_id, text,\nroot_cause, impact,\nrecommendations,\nprovider, tokens_used)
activate DB
DB --> ES : explanation_id
deactivate DB

ES -> VEC : INSERT embedding\nINTO pgvector index\n(explanation_id, vector)
activate VEC
VEC --> ES : OK
deactivate VEC

== 7. Mise en cache ==

ES -> RED : cache_explanation(\nfingerprint, explanation,\nttl=3600)

deactivate ES

@enduml
