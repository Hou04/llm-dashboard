@startuml ch4_uc_sprint1
' ============================================================
' CHAPITRE 4 — Diagramme de Cas d'Utilisation — Sprint 1
' Figure 4.x : Cas d'utilisation du Sprint 1
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 10
skinparam actorStyle awesome

skinparam usecase {
  BackgroundColor #ECF0F1
  BorderColor #2C3E50
  FontColor #2C3E50
}

left to right direction

actor "Super\nAdministrateur" as SA #E74C3C
actor "Administrateur\nTenant" as TA #3498DB
actor "Agent\nApplicatif" as AG #F39C12
actor "Observateur" as OB #2ECC71

rectangle "Sprint 1 — Infrastructure & Gateway" {

  package "Authentification (M7)" {
    usecase "S'inscrire" as UC1
    usecase "Se connecter\n(JWT)" as UC2
    usecase "Se déconnecter" as UC3
    usecase "Gérer les\nutilisateurs" as UC4
    usecase "Gérer les\nclés API" as UC5
  }

  package "Gateway LLM (M1)" {
    usecase "Envoyer un\nappel LLM" as UC6
    usecase "Appliquer les\nrègles de gouvernance" as UC7
    usecase "Consulter les\nlogs d'appels" as UC8
  }

  package "Gouvernance (M4)" {
    usecase "Créer une règle\nde gouvernance" as UC9
    usecase "Activer/Désactiver\nune règle" as UC10
  }

  package "Dashboard (M8)" {
    usecase "Consulter le\ntableau de bord" as UC11
    usecase "Recevoir les mises\nà jour temps réel" as UC12
  }
}

SA --> UC2
SA --> UC4
TA --> UC2
TA --> UC3
TA --> UC5
TA --> UC8
TA --> UC9
TA --> UC10
TA --> UC11
TA --> UC12
OB --> UC2
OB --> UC11
AG --> UC6

UC6 ..> UC7 : <<include>>
UC11 ..> UC12 : <<extend>>

@enduml
