@startuml ch6_uc_sprint3
' ============================================================
' CHAPITRE 6 — Diagramme de Cas d'Utilisation — Sprint 3
' Figure 6.x : Cas d'utilisation du Sprint 3
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 10
skinparam actorStyle awesome

skinparam usecase {
  BackgroundColor #ECF0F1
  BorderColor #2C3E50
  FontColor #2C3E50
}

left to right direction

actor "Super\nAdministrateur" as SA #E74C3C
actor "Administrateur\nTenant" as TA #3498DB
actor "Celery Beat\n(Scheduler)" as CB #9B59B6

rectangle "Sprint 3 — Fonctionnalités Entreprise" {

  package "Facturation (M10)" {
    usecase "Créer un\ncontrat" as UC1
    usecase "Consulter les\nfactures" as UC2
    usecase "Générer les factures\nautomatiquement" as UC3
    usecase "Modifier le statut\nd'une facture" as UC4
  }

  package "Traçage (M9)" {
    usecase "Consulter les\nsessions LLM" as UC5
    usecase "Visualiser le\nwaterfall d'appels" as UC6
    usecase "Configurer l'A/B\ntesting de prompts" as UC7
  }

  package "Prompts (M11)" {
    usecase "Créer un template\nde prompt" as UC8
    usecase "Versionner un\ntemplate" as UC9
    usecase "Publier un\ntemplate" as UC10
  }

  package "Tenants" {
    usecase "Créer un\nnouveau tenant" as UC11
    usecase "Activer/Désactiver\nun tenant" as UC12
    usecase "Configurer les\nparamètres tenant" as UC13
  }
}

SA --> UC1
SA --> UC2
SA --> UC4
SA --> UC11
SA --> UC12
SA --> UC13

TA --> UC2
TA --> UC5
TA --> UC6
TA --> UC7
TA --> UC8
TA --> UC9
TA --> UC10

CB --> UC3 : <<scheduled>>\nMensuel

UC1 ..> UC3 : <<include>>
UC5 ..> UC6 : <<extend>>
UC8 ..> UC9 : <<include>>

@enduml
